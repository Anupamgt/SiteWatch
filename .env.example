# =============================================================================
# Supabase PostgreSQL (recommended) or local Docker Postgres
# =============================================================================
# Supabase → Project Settings → Database:
#   DATABASE_URL  = "Transaction" pooler URI (port 6543) + ?schema=public
#   DIRECT_URL    = "Session" pooler OR "Direct connection" URI (port 5432) + ?schema=public
# Append sslmode=require if not already present.
# Example shapes (replace USER, PASSWORD, HOST, DB):
#   DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=public"
#   DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=public"
# Local Docker fallback (docker-compose.yml → host 5433):
DATABASE_URL="postgresql://dpr:dpr@localhost:5433/dpr_site_control?schema=public"
DIRECT_URL="postgresql://dpr:dpr@localhost:5433/dpr_site_control?schema=public"

# =============================================================================
# NextAuth
# =============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"

# =============================================================================
# Google OAuth (NextAuth — not Supabase Auth)
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Authorized JavaScript origins:  http://localhost:3000
# Authorized redirect URIs:       http://localhost:3000/api/auth/callback/google
# Then allow-list each Gmail:
#   npm run db:register-google -- you@gmail.com ADMIN "Your Name"
# =============================================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email: console (default, logs only) | resend | smtp
# Corrective actions call sendEmail() on create + resend.
#
# --- Resend (recommended on Vercel) ---
# 1. https://resend.com → API Keys → create key
# 2. Verify a domain (or use onboarding@resend.dev for tests to your own inbox)
# EMAIL_PROVIDER="resend"
# MAIL_FROM="SiteWatch <onboarding@resend.dev>"
# RESEND_API_KEY="re_..."
#
# --- Gmail SMTP (App Password) ---
# 1. Google Account → Security → 2-Step Verification → App passwords
# 2. Create app password for "Mail"
# EMAIL_PROVIDER="smtp"
# MAIL_FROM="SiteWatch <you@gmail.com>"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@gmail.com"
# SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
# SMTP_SECURE="false"
#
# Test: npm run email:test -- you@gmail.com
EMAIL_PROVIDER="console"
MAIL_FROM="SiteWatch <dpr@example.com>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# =============================================================================
# Redis cache (Upstash — recommended on Vercel)
# https://console.upstash.com → Create database → REST API → copy URL + token
# Used for: login rate limiting across instances, field-definition cache.
# If unset, the app falls back to in-memory (single-instance only).
# =============================================================================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# File storage: local | gcs
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./public/uploads"
GCS_BUCKET=""
GCS_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# App
APP_TIMEZONE="Asia/Kolkata"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin123"
SEED_ENGINEER_EMAIL="engineer@example.com"
SEED_ENGINEER_PASSWORD="engineer123"
SEED_SUPERVISOR_PASSWORD="nitish123"
