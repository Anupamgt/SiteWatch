# Database — PostgreSQL via Prisma (local Docker default matches docker-compose.yml)
DATABASE_URL="postgresql://dpr:dpr@localhost:5433/dpr_site_control?schema=public"
# Optional: direct (non-pooled) connection for migrations
DIRECT_URL="postgresql://dpr:dpr@localhost:5433/dpr_site_control?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"

# Google OAuth (optional). When set, "Continue with Google" appears on /login.
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Allow-list each Gmail first: npm run db:register-google -- you@gmail.com ADMIN "Your Name"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email: resend | smtp | console
EMAIL_PROVIDER="console"
MAIL_FROM="SiteWatch <dpr@example.com>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# File storage: local | gcs
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./public/uploads"
GCS_BUCKET=""
GCS_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# App
APP_TIMEZONE="Asia/Kolkata"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin123"
SEED_ENGINEER_EMAIL="engineer@example.com"
SEED_ENGINEER_PASSWORD="engineer123"
# Third seeded login (email is fixed as nitish@example.com in prisma/seed.ts)
SEED_SUPERVISOR_PASSWORD="nitish123"
