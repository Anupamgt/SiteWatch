# =============================================================================
# Database — PostgreSQL (Prisma)
# Local Docker: docker compose up -d  → host port 5433
# Supabase: Project Settings → Database → Connection string
#   - DATABASE_URL  = Transaction pooler (port 6543) + ?pgbouncer=true
#   - DIRECT_URL    = Session / Direct (port 5432) for migrations
# =============================================================================
DATABASE_URL="postgresql://dpr:dpr@localhost:5433/dpr_site_control?schema=public"
DIRECT_URL="postgresql://dpr:dpr@localhost:5433/dpr_site_control?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"

# =============================================================================
# Google OAuth — Continue with Google on /login
# 1. https://console.cloud.google.com/apis/credentials
# 2. Create OAuth client ID → Web application
# 3. Authorized JavaScript origins:  http://localhost:3000
# 4. Authorized redirect URIs:
#      http://localhost:3000/api/auth/callback/google
# 5. Paste Client ID + Secret below, then restart npm run dev
# 6. Allow-list your Gmail:
#      npm run db:register-google -- you@gmail.com ADMIN "Your Name"
# =============================================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email: resend | smtp | console
EMAIL_PROVIDER="console"
MAIL_FROM="SiteWatch <dpr@example.com>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# File storage: local | gcs
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./public/uploads"
GCS_BUCKET=""
GCS_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# App
APP_TIMEZONE="Asia/Kolkata"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin123"
SEED_ENGINEER_EMAIL="engineer@example.com"
SEED_ENGINEER_PASSWORD="engineer123"
SEED_SUPERVISOR_PASSWORD="nitish123"
