# =============================================================================
# Production environment (Vercel / any host) — copy into the host's env UI
# Do NOT commit real secrets. .env is gitignored; this file is a checklist.
# =============================================================================

# Supabase Postgres — Transaction pooler (6543) for the app
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require&schema=public"
# Session pooler (5432) for prisma migrate deploy during build
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&schema=public"

# NextAuth — use your real HTTPS origin (no trailing slash)
NEXTAUTH_URL="https://YOUR_DOMAIN.vercel.app"
# Fresh secret for production (do not reuse local): openssl rand -base64 32
NEXTAUTH_SECRET=""

# Google OAuth — same client as local, with PRODUCTION origins/redirects added:
#   Origin:  https://YOUR_DOMAIN.vercel.app
#   Redirect: https://YOUR_DOMAIN.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email — console logs only; use resend or smtp for real corrective-action mail
EMAIL_PROVIDER="console"
MAIL_FROM="SiteWatch <noreply@YOUR_DOMAIN>"
# RESEND_API_KEY=""

# Redis (Upstash) — login rate limit + field cache across Vercel instances
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# File storage — local is NOT durable on Vercel. Use gcs (or skip photo uploads).
STORAGE_DRIVER="local"
# STORAGE_DRIVER="gcs"
# GCS_BUCKET=""
# GCS_PROJECT_ID=""
# GOOGLE_APPLICATION_CREDENTIALS=""

APP_TIMEZONE="Asia/Kolkata"
